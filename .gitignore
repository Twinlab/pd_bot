# Исключаем каталоги data и downloads
/data/
/downloads/

# Но сохраняем структуру директорий с помощью .gitkeep
!/data/.gitkeep
!/downloads/.gitkeep

# Исключаем временные файлы
*.tmp
*.temp

# Исключаем файлы настроек и личные данные
config.json
user_links.json
user_activities.json

# Исключаем файлы кэша Python
__pycache__/
*.py[cod]
*$py.class

# Исключаем виртуальное окружение Python (если используется)
venv/
env/
.env/

# Исключаем системные файлы
.DS_Store
Thumbs.db
.vscode/
.idea/

# Исключаем логи
*.log

# Исключаем файлы унификации
check_docstrings.py
check_standards.py
check_typing.py
fix_logging.py
format_code.py
unify_project.py
docstring_template.py
UNIFICATION_PLAN.md
docs/UNIFICATION_PLAN_DETAILED.md

# Coverage reports
.coverage
coverage/

# Python packaging
*.egg-info/
*.egg
dist/
build/
