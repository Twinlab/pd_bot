# Исключаем каталоги data и downloads
/data/
/downloads/

# Но сохраняем структуру директорий с помощью .gitkeep
!/data/.gitkeep
!/downloads/.gitkeep

# Lavalink скачивает jar-плагины при старте; конфиг application.yml храним в репо,
# а сами артефакты — нет.
/lavalink/plugins/*
!/lavalink/plugins/.gitkeep
/lavalink/logs/

# Исключаем временные файлы
*.tmp
*.temp

# Исключаем файлы настроек и личные данные
config.json
user_links.json
user_activities.json
.env

# Исключаем файлы кэша Python
__pycache__/
*.py[cod]
*$py.class

# Исключаем виртуальное окружение Python (если используется)
venv/
env/
.env/

# Исключаем системные файлы
.DS_Store
Thumbs.db
.vscode/
.idea/

# Исключаем логи
*.log

# Исключаем временные планы
docs/UNIFICATION_PLAN_DETAILED.md
docs/TEST_COVERAGE_PLAN.md
docs/MIGRATION_GUIDE.md
plan-modernize.md
# Coverage reports
.coverage
coverage/

# Python packaging
*.egg-info/
*.egg
dist/
build/

# Исключаем план улучшений
docs/IMPROVEMENT_PLAN_COMPLETE.md

# Optimization plans and backups
OPTIMIZATION_PLAN.md
backups/

# Memory Bank
memory-bank/

# Claude Code
# CLAUDE.md is a symlink to AGENTS.md — keep it tracked
site/

# Локальные служебные скрипты, не входящие в публичный репозиторий
/scripts/

# Внутренние заметки по фичам
docs/top_reactions.md

# Локальные дебаг-заметки (между сессиями) — НЕ коммитим
DEBUG_*.md
NOTES_*.md
TODO_*.md
