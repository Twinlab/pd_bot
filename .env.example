# Обязательные настройки
BOT_TOKEN=your_discord_bot_token_here
STRATZ_API_KEY=your_stratz_api_key_here

# Опциональные настройки
BOT_PREFIX=!
BOT_ENVIRONMENT=production
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
PROXY_URL=http://proxy:port

# Переопределение каналов (опционально)

# Настройки Watchtower (для автоматического обновления)
# Создайте PAT (Personal Access Token) в GitHub с правами read:packages
REPO_USER=your_github_username
REPO_PASS=your_github_pat_token
BOT_CHANNELS__LOGGING=1365045098785542224
