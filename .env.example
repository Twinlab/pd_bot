# =============================================================================
# Обязательные настройки
# =============================================================================
BOT_TOKEN=your_discord_bot_token_here
STRATZ_API_KEY=your_stratz_api_key_here

# =============================================================================
# Опциональные настройки бота
# =============================================================================
BOT_PREFIX=!
BOT_ENVIRONMENT=production
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
PROXY_URL=http://proxy:port

# =============================================================================
# Danbooru — источник картинок для аниме-модуля (опционально, но рекомендуется)
# =============================================================================
# Без креды бот ходит анонимно с лимитом в 2 тега на запрос. С ключом — выше
# лимиты запросов. Зарегистрируйся на https://danbooru.donmai.us, затем
# My Account → API Key → создай ключ. DANBOORU_LOGIN — это твой username.
DANBOORU_LOGIN=
DANBOORU_API_KEY=

# Переопределение каналов
BOT_CHANNELS__LOGGING=1365045098785542224

# =============================================================================
# Lavalink — обязательно для музыкального модуля
# =============================================================================
# Хост и порт Lavalink. Внутри docker-compose это "lavalink:2333"
# (имя сервиса в той же сети). При локальном запуске бота вне docker — "localhost:2333".
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
# Пароль для подключения к Lavalink. ОБЯЗАТЕЛЬНО смени на случайный в проде!
# Сгенерировать: openssl rand -hex 32
LAVALINK_SERVER_PASSWORD=youshallnotpass

# =============================================================================
# YouTube OAuth — обход bot-detection (рекомендуется!)
# =============================================================================
# Refresh token от BURNER Google-аккаунта (НЕ ОСНОВНОЙ — есть риск блока!).
# Как получить: запусти Lavalink с пустым YOUTUBE_REFRESH_TOKEN, смотри логи,
# зайди по device-flow URL, авторизуйся, скопируй refresh_token из логов сюда.
# Подробнее: docs/deployment.md
YOUTUBE_REFRESH_TOKEN=

# =============================================================================
# Spotify (опционально — нужно только для распознавания Spotify-ссылок и spsearch:)
# =============================================================================
# https://developer.spotify.com/dashboard — создай приложение и возьми ID/Secret.
# Без них Spotify-треки не будут разрешаться, но YouTube/SoundCloud работают как обычно.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# =============================================================================
# Watchtower — авто-апдейт контейнеров с GHCR
# =============================================================================
# Создай PAT в GitHub с правами read:packages
REPO_USER=your_github_username
REPO_PASS=your_github_pat_token
